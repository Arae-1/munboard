worker_processes 1;
user nginx;

error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr -> $request [$status] - '
                    'referer: $http_referer $http_x_forwarded_for';
    access_log /dev/stdout main;

    server_tokens off;
    keepalive_timeout 65;

    # HSTS: only send Strict-Transport-Security when the request actually
    # reached this server over HTTPS. This example block listens on plain
    # HTTP, so that only happens when an upstream proxy terminates TLS and
    # forwards `X-Forwarded-Proto: https`. If you terminate TLS directly in
    # nginx, move the HSTS header into the 443 server block instead, and add
    # "preload" only after submitting the domain to https://hstspreload.org.
    map $http_x_forwarded_proto $hsts_header {
        https   "max-age=31536000; includeSubDomains";
        default "";
    }

    # CORS: mirror the request's Origin only when it is the site itself
    # (matches the Host header the browser used). Cross-site pages therefore
    # receive no Access-Control-Allow-Origin and cannot read API responses;
    # the bundled client is same-origin and never needs the header. If you
    # deliberately serve the API to other origins, replace this map with an
    # explicit allowlist of those origins instead of a wildcard.
    map "$host|$http_origin" $cors_origin {
        default "";
        "~*^(?<h>[^|]+)\|https?://\k<h>(:\d+)?$" $http_origin;
    }

    upstream backend {
        server __BACKEND__:6666;
    }

    server {
        listen 80 default_server;

        # Security headers, sent on every response (including errors via
        # `always`). The /api/ location repeats them below because a location
        # with its own add_header does not inherit server-level ones.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # Starting-point CSP for the bundled client; tune it to your own
        # client build:
        #   - scripts load from 'self' plus unpkg.com (Ruffle Flash emulator)
        #   - style-src 'unsafe-inline' because the client injects <style>
        #     rules at runtime (see client/js/{tags,pools}.js)
        #   - connect-src allows the WebSocket the client opens on port 8081
        # If your client uses inline scripts, you will need to hash or nonce
        # them instead of relaxing script-src.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        add_header Strict-Transport-Security $hsts_header always;

        # Add Swagger UI proxying
        location ~ ^/(docs|apidoc) {
            proxy_pass http://backend;
        }

        location ~ ^/api$ {
            return 302 /api/;
        }

        location ~ ^/api/(.*)$ {
            tcp_nodelay on;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Real-IP $remote_addr;

            # CORS is granted only when the Origin is the site itself (see the
            # $cors_origin map above); the bundled client is same-origin.
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            # Repeat the server-level security headers here: a location that
            # defines its own add_header does not inherit server-level ones.
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
            add_header Strict-Transport-Security $hsts_header always;

            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Methods'
                    'GET, POST, PUT, DELETE, OPTIONS';
                add_header 'Access-Control-Allow-Headers'
                    'Authorization, Content-Type';
                return 200;
            }

            client_max_body_size 8G;

            gzip on;
            gzip_comp_level 3;
            gzip_min_length 20;
            gzip_proxied expired no-cache no-store private auth;
            gzip_types text/plain application/json;

            if ($request_uri ~* "/api/(.*)") {
                proxy_pass http://backend/$1;
            }

            error_page 500 502 503 504 @badproxy;
        }

        location /data/ {
            # Legacy redirect for old flat post URLs
            location ~ ^/data/posts/[^/]+$ {
                rewrite ^/data/posts/(.+)$ /legacy/redirect/$1 break;
                proxy_pass http://backend;
            }

            rewrite ^/data/(.*) /$1 break;
            root /data;

            sendfile on;
            tcp_nopush on;
            tcp_nodelay on;

            error_page 403 @unauthorized;
            error_page 404 @notfound;
        }

        # Serve OpenGraph embed pages for post URLs
        location ~ ^/post/[0-9]+/?$ {
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Original-URI $request_uri;
            rewrite ^/post/([0-9]+)/?$ /embed/post/$1 break;
            proxy_pass http://backend;
        }

        location / {
            root /var/www;
            try_files $uri /index.htm;

            sendfile on;
            tcp_nopush on;
            tcp_nodelay on;

            gzip_static on;
            gzip_proxied expired no-cache no-store private auth;
        }

        location @unauthorized {
            return 403 "Unauthorized";
            default_type text/plain;
        }

        location @notfound {
            return 404 "Not Found";
            default_type text/plain;
        }

        location @badproxy {
            return 502 "Failed to connect to oxibooru REST API";
            default_type text/plain;
        }
    }
}

daemon off;
