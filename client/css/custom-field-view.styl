@import colors

#custom-field
    width: 100%
    max-width: 40em
    h1
        word-break: break-all
        line-height: 130%
        margin-top: 0
    form
        width: 100%
    .custom-field-edit
        textarea
            height: 10em
    .custom-field-summary
        section
            &.description
                margin: 1.5em 0 0 0
            &.details
                vertical-align: top
                padding-right: 0.5em
                section
                    margin-bottom: 1em
