@import colors

div.custom-field-input
    position: relative

    .main-control
        display: flex
        flex-wrap: wrap
        gap: 0.3em
        input.cf-name
            flex: 2
            min-width: 8em
        input.cf-value
            flex: 1
            min-width: 5em
        button
            flex: none
            margin: 0

ul.compact-custom-fields
    width: 100%
    margin: 0.5em 0 0 0
    padding: 0
    li
        margin: 0
        width: 100%
        line-height: 140%
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        transition: background-color 0.5s linear
        cursor: pointer
        a
            display: inline
        a:focus
            outline: 0
            box-shadow: inset 0 0 0 2px $main-color
        &.editing
            background: $top-navigation-color
    i
        padding-right: 0.4em

div.custom-field-input, ul.compact-custom-fields
    .custom-field-usages, .remove-custom-field
        color: $inactive-link-color
        unselectable()
    .custom-field-usages
        font-size: 90%
        margin-left: 0.7em
    .remove-custom-field
        margin-right: 0.5em

.darktheme
    ul.compact-custom-fields
        li
            &.editing
                background: $top-navigation-color-darktheme
    div.custom-field-input, ul.compact-custom-fields
        .custom-field-usages, .remove-custom-field
            color: $inactive-link-color-darktheme
